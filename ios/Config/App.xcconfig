// The app target (on top of Debug or Release.xcconfig).

PRODUCT_NAME = Napsack
PRODUCT_BUNDLE_IDENTIFIER = $(NAPSACK_BUNDLE_ID)
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/App-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = napsack
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
// Asked the first time the app reaches a development server on your network.
INFOPLIST_KEY_NSLocalNetworkUsageDescription = napsack connects to a development server on your network.
INFOPLIST_KEY_NSCameraUsageDescription = napsack uses the camera for the pics and videos you send.
INFOPLIST_KEY_NSMicrophoneUsageDescription = napsack records sound with the videos you send.
INFOPLIST_KEY_NSPhotoLibraryUsageDescription = napsack sends photos you choose.
INFOPLIST_KEY_NSFaceIDUsageDescription = napsack uses Face ID to unlock, when you turn the lock on in Settings.
// Export compliance (Nate, 2026-11-02): all of the app's encryption is Apple's
// own (CryptoKit, CommonCrypto, HTTPS), so uploads don't ask again.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
// Notifications (Notifications.swift) and links opening the app (Links.swift):
// development in Xcode builds and production in Release (Release.xcconfig).
// A free Apple ID's team can't have them: Local.xcconfig empties this line.
CODE_SIGN_ENTITLEMENTS = Config/Napsack.entitlements
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_PREVIEWS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
SWIFT_EMIT_LOC_STRINGS = YES

// Release builds carry no test data: the pinned vectors (and their scripts) are for
// the encryption checks, which only development builds run (plan-ios.md, section 12).
EXCLUDED_SOURCE_FILE_NAMES[config=Release] = vectors
